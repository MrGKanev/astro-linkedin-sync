{
  "name": "astro-linkedin-sync",
  "version": "0.2.7",
  "description": "Sync your LinkedIn profile data export into Astro content collections. Auto-syncing integration, drop-in components, and CLI \u2014 keep your portfolio, CV, and resume in sync without duplicating work.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Gabriel Kanev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrGKanev/astro-linkedin-sync.git"
  },
  "bugs": {
    "url": "https://github.com/MrGKanev/astro-linkedin-sync/issues"
  },
  "homepage": "https://github.com/MrGKanev/astro-linkedin-sync#readme",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "bin": {
    "astro-linkedin-sync": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./components/*": "./dist/components/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "cli": "node --experimental-strip-types src/cli.ts",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build && tsc --noEmit && pnpm test"
  },
  "keywords": [
    "astro",
    "withastro",
    "astro-integration",
    "astro-component",
    "linkedin",
    "linkedin-profile",
    "linkedin-export",
    "sync",
    "data-export",
    "content-collections",
    "portfolio",
    "developer-portfolio",
    "cv",
    "resume",
    "career",
    "profile",
    "markdown"
  ],
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "pdf-parse": "^2.4.5",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/yauzl": "^3.4.0",
    "astro": "^7.4.12",
    "typescript": "^7.0.2"
  }
}
